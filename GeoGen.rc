END

IDD_SETTINGS DIALOGEX 0, 0, 189, 188
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,68,167,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,132,167,50,14
    LTEXT           "Resolution",IDC_STATIC,7,7,61,8
    EDITTEXT        IDC_EDIT_RESOLUTION,84,7,80,12,ES_AUTOHSCROLL
    LTEXT           "Min altitude (m)",IDC_STATIC,7,37,61,8
    EDITTEXT        IDC_EDIT_MIN_ALT,84,37,80,12,ES_AUTOHSCROLL
    LTEXT           "Max altitude (m)",IDC_STATIC,7,51,61,8
    EDITTEXT        IDC_EDIT_MAX_ALT,84,51,80,12,ES_AUTOHSCROLL
    LTEXT           "Extent (km)",IDC_STATIC,7,22,61,8
    EDITTEXT        IDC_EDIT_TERRAIN_EXTENT,84,22,80,12,ES_AUTOHSCROLL
    LTEXT           "Sea level (m)",IDC_STATIC,7,66,61,8
    EDITTEXT        IDC_EDIT_SEA_LEVEL,84,66,80,12,ES_AUTOHSCROLL
    LTEXT           "<Resolution Statistics>",IDC_STATIC_RESOLUTION_STATISTICS,7,84,175,11
    LTEXT           "Camera FOV",IDC_STATIC,7,97,61,8
    EDITTEXT        IDC_EDIT_CAM_FOV,84,97,80,12,ES_AUTOHSCROLL
    LTEXT           "Camera Near Clip",IDC_STATIC,7,112,61,8
    EDITTEXT        IDC_EDIT_CAM_NEAR_CLIP,84,112,80,12,ES_AUTOHSCROLL
    LTEXT           "Camera Far Clip",IDC_STATIC,7,127,61,8
    EDITTEXT        IDC_EDIT_CAM_FAR_CLIP,84,127,80,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Setup GeoData providers...",IDC_BUTTON_SETUP_GEODATA_PROVIDER,68,145,114,12
END

IDD_DIALOG_DEM_CAPTURE DIALOGEX 0, 0, 313, 129
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Download elevations"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,199,108,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,256,108,50,14
