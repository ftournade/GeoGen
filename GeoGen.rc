    EDITTEXT        IDC_EDIT_RESOLUTION,77,7,75,12,ES_AUTOHSCROLL
    LTEXT           "Filename",IDC_STATIC,7,41,65,8
    EDITTEXT        IDC_EDIT_FILENAME,77,37,205,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE_FILE,288,37,18,12
    CONTROL         "Resize terrain",IDC_CHECK_RESIZE_TERRAIN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,68,65,8
    CONTROL         "Clip at sea level",IDC_CHECK_CLIP_AT_SEA_LEVEL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,78,65,8
    CONTROL         "Underwater",IDC_CHECK_UNDERWATER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,89,65,8
    LTEXT           "Color Resolution",IDC_STATIC,7,21,65,8
    EDITTEXT        IDC_EDIT_COLORSAT_RESOLUTION,77,21,75,12,ES_AUTOHSCROLL | WS_DISABLED
    CONTROL         "Export ColorSat",IDC_CHECK_EXPORT_COLORSAT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,57,65,8
END

IDD_DIALOG_APIKEY DIALOGEX 0, 0, 277, 98
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GeoData provider setup"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Elevation tiles come from AWS Terrain Tiles and need no key.",IDC_STATIC,7,7,263,8
    LTEXT           "Satellite imagery needs a MapTiler API key (free plan, non-commercial use):",IDC_STATIC,7,24,263,8
    EDITTEXT        IDC_EDIT_APIKEY,7,37,180,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Get a free key...",IDC_BUTTON_GET_MAPTILER_KEY,193,36,77,14
    LTEXT           "Leave empty to download elevation only.",IDC_STATIC,7,54,263,8
    DEFPUSHBUTTON   "OK",IDOK,166,77,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,220,77,50,14
END

